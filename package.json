{
  "name": "aurora-alarm",
  "version": "1.0.0",
  "description": "Aurora Alarm - Notifies when auroras are likely visible at your location",
  "main": "index.js",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "build": "tsc --build",
    "bundle": "ncc build src/index.ts -o build",
    "exe": "pkg build/index.js --targets node18-win-x64 --output build/aurora-alarm.exe"
  },
  "author": "Oleg Spakov",
  "license": "MIT",
  "type": "module",
  "pkg": {
    "assets": [],
    "icon": "./assets/icon.png"
  },
  "dependencies": {
    "@types/dateformat": "^5.0.3",
    "@types/node-notifier": "^8.0.5",
    "dateformat": "^5.0.3",
    "fast-xml-parser": "^5.3.0",
    "node-notifier": "^10.0.1"
  }
}
